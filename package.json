{
  "name": "wikimasters-tools",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Extension non officielle et en lecture seule pour wiki-masters.com (Chrome, Firefox, Firefox Android)",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "dev:firefox": "wxt -b firefox --mv3",
    "package": "npm run zip && npm run zip:firefox",
    "build:overlay": "vite build -c vite.android.config.ts",
    "apk": "node scripts/build-apk.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.0",
    "vitest": "^5.0.2",
    "wxt": "^0.21.4"
  }
}
